# ETHER 環境變數範本（.env.example）
#
# 狀態：草案／待批准。全部變數皆為佔位符，不得含真實金鑰、真實密碼、真實 Token。
# 使用方式：複製為 .env 後填入各環境的實際值；實際值以 OpenBao／環境注入提供，
# 不得將填入真實值的 .env 提交至 Git（.env 須在 .gitignore 中，待 Phase 01 確認）。
# 本檔案的預設值（如 change-me、example.invalid）皆為佔位符，不得用於正式環境。
# 此 VM 無 docker，本檔案與 docker-compose.yml 皆為「待 CI 或有 Docker 的環境驗證」。
#
# 架構調整（2026-11-25 00:33 使用者指令）：PostgreSQL 自架、Valkey、MinIO、
# Meilisearch、OpenBao、Keycloak、Traefik、NATS JetStream、LiveKit Community Edition、
# pgvector（已定案，見 ADR-017）、Ollama＋vLLM、Prometheus＋Grafana＋Loki、GlitchTip。

# ---------- 網域與憑證 ----------
# 正式網域（佔位符）；本機開發可用 example.invalid，不得填入未擁有的真實網域而不經確認。
DOMAIN=example.invalid
# Let's Encrypt ACME 聯絡 Email（佔位符）。
ACME_EMAIL=admin@example.invalid

# ---------- PostgreSQL（自架） ----------
POSTGRES_DB=ether
POSTGRES_USER=ether
POSTGRES_PASSWORD=change-me
# Keycloak 與 GlitchTip 的資料庫名（共用 PostgreSQL 主機、獨立資料庫，草案，待定稿）。
KEYCLOAK_DB=keycloak
GLITCHTIP_DB=glitchtip

# ---------- Valkey（快取／Session） ----------
# Valkey 無獨立密碼變數時，以本檔案的共用憑證機制為準，方式待定稿；不得預寫。
# VALKEY_PASSWORD=change-me

# ---------- NATS JetStream ----------
# NATS 認證方式待定稿；不得預寫憑證。
# NATS_USER=change-me
# NATS_PASSWORD=change-me

# ---------- MinIO（物件儲存） ----------
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me
# 媒體 Bucket 名（草案，待定稿）。
MINIO_BUCKET=ether-media
# MinIO 存取金鑰（應用服務用，草案，待 OpenBao 注入方式定稿）。
# MINIO_ACCESS_KEY=change-me
# MINIO_SECRET_KEY=change-me

# ---------- Meilisearch（搜尋投影） ----------
MEILI_MASTER_KEY=change-me
# MEILI_API_KEY=change-me
# api 服務的搜尋索引後端選擇（Track A 新增，草案，待定稿）：
# SEARCH_INDEX=memory（預設，記憶體索引）或 meilisearch。
# SEARCH_INDEX=meilisearch 時，API 金鑰取 MEILISEARCH_API_KEY
#（未設定時啟動明確報錯，不得靜默退回記憶體索引）。
# SEARCH_INDEX=memory
# MEILISEARCH_API_KEY=change-me

# ---------- 背景迴圈開關（Track A 新增，草案，待定稿） ----------
# RELAY_ENABLED=true 時，api 行程啟動 Relay 輪詢 Outbox、經 NATS
# JetStream 發佈事件（Stream 須由部署方預先建立，見 relay 套件）。
# SEARCH_CONSUMER_ENABLED=true 時，api 行程訂閱 NATS 事件、經
# Projector 寫入搜尋索引。兩者預設皆關閉。
# RELAY_ENABLED=false
# SEARCH_CONSUMER_ENABLED=false

# ---------- OpenBao（Secrets） ----------
# OpenBao 的位址、Token、解封金鑰，正式環境一律以環境注入提供，不得寫入本檔案。
# OPENBAO_ADDR=http://openbao:8200
# OPENBAO_TOKEN=change-me
# OPENBAO_UNSEAL_KEY=change-me

# ---------- Keycloak（身分提供者） ----------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
# Keycloak Realm／Client 識別碼（草案，待身分文件定稿）。
KEYCLOAK_REALM=ether
KEYCLOAK_CLIENT_ID=ether-api
# KEYCLOAK_CLIENT_SECRET=change-me
# Token aud 強制值（M2b 新增）：正式部署應設為 API Client 識別碼
# （與 KEYCLOAK_CLIENT_ID 相同）；留空表示不強制 aud（開發預設）。
# KEYCLOAK_AUDIENCE=ether-api
# 身分儲存後端（M2b 新增）：postgres（預設）或 memory（開發／測試用，
# 資料不持久）。正式環境不得設為 memory。
IDENTITY_STORE=postgres

# ---------- Traefik ----------
# Traefik 無獨立應用密碼；憑證解析器見 docker-compose.yml（Let's Encrypt）。

# ---------- LiveKit Community Edition（通話 SFU） ----------
# LiveKit API Key／Secret（佔位符，格式與產生方式待 Phase 07 定稿）。
LIVEKIT_KEYS=change-me
# TURN 憑證與公網位址待 Phase 07 評估定稿；不得預寫。
# LIVEKIT_TURN_DOMAIN=turn.example.invalid

# ---------- Ollama／vLLM（本地 AI） ----------
# 模型清單待 Phase 09 評估定稿；不得假設一般伺服器跑得動所有模型。
OLLAMA_MODELS=
# 外部 AI API 金鑰（可選擴充，僅在使用者決定使用外部 AI 時填入；不得寫死，不得提交）。
# EXTERNAL_AI_API_KEY=change-me

# ---------- Grafana（監控儀表板） ----------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# ---------- GlitchTip（錯誤追蹤，自架） ----------
GLITCHTIP_SECRET_KEY=change-me

# ---------- 推播（FCM／APNs） ----------
# 推播憑證／金鑰一律以檔案或 OpenBao 注入，不得寫入本檔案；供應商配置待定稿。
# FCM_CREDENTIALS_FILE=
# APNS_KEY_FILE=

# ---------- 簡訊 OTP（仍可能付費，待查證） ----------
# 簡訊供應商與金鑰待查證與使用者決定；未決定前不得填入，不得宣稱已整合。
# SMS_PROVIDER=
# SMS_API_KEY=change-me

# ---------- 付款（合規第三方，待決定） ----------
# 付款供應商與金鑰待決定；不得自行儲存信用卡完整資訊；未決定前不得填入。
# PAYMENT_PROVIDER=
# PAYMENT_API_KEY=change-me

# ---------- 應用服務 ----------
# Go API／Realtime Gateway／Worker 的環境變數（資料庫、快取、佇列、儲存、搜尋、
# 身分位址）由 docker-compose.yml 以服務名組裝，應用服務不得自行假設位址；
# 需覆寫時，在此以 _OVERRIDE 後綴新增，覆寫清單待 Phase 01 定稿。
# API_PORT=8080
# GATEWAY_PORT=8081

# ==========================================================================
# Phase 01 附加（2026-11-25，Infra 軌；以下為附加段落，檔案上半部原有內容一字未動）
# 本段全部變數皆為佔位符／停用預設，不得含真實值。以下行首加 # 者為「停用
# 預設」：取消註解即啟用該覆寫／接線；未取消註解時，以 docker-compose.yml
# 組裝的服務位址與預設行為為準。正式值一律以 OpenBao／環境注入提供，不得
# 將填入真實值的 .env 提交至 Git。
# ==========================================================================

# ---------- 應用服務覆寫（_OVERRIDE，停用預設） ----------
# 覆寫慣例與 services/api/internal/config/config.go 的 resolve 一致：
# 任一依賴位址可以 <NAME>_OVERRIDE 覆寫，覆寫值優先於 compose 組裝值
# （例如 DATABASE_URL_OVERRIDE 優先於 DATABASE_URL）；覆寫清單的最終定稿
# 待 Phase 01 確認。以下變數名不加服務前綴（服務前綴形式無程式碼讀取，
# 不得使用）。適用範圍依 compose 各服務的 environment 而定：api 六項全有；
# gateway 僅 DATABASE_URL／VALKEY_URL／NATS_URL；worker 僅前五項
# （無 KEYCLOAK_URL）。埠號變數見上半部既有 API_PORT／GATEWAY_PORT 註解行
# （非 _OVERRIDE 形式）；WORKER_PORT 僅為 worker 骨架內的佔位名，
# compose 未設定，不得假裝已接線。
# DATABASE_URL_OVERRIDE=postgres://ether:change-me@postgresql:5432/ether?sslmode=disable
# VALKEY_URL_OVERRIDE=redis://valkey:6379/0
# NATS_URL_OVERRIDE=nats://nats:4222
# MINIO_ENDPOINT_OVERRIDE=minio:9000
# MEILISEARCH_URL_OVERRIDE=http://meilisearch:7700
# KEYCLOAK_URL_OVERRIDE=http://keycloak:8080

# ---------- OpenTelemetry（停用預設，SDK 接線待後階段） ----------
# OTLP endpoint：Collector 服務尚未在 docker-compose.yml 中定義，服務名與
# 埠號為暫定慣例，待可觀測性接線定稿後覆核；不得指向不存在的服務假裝已接線。
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# OTEL_SERVICE_NAME=ether-api

# ---------- Loki 與錯誤追蹤端點（停用預設，SDK 接線待後階段） ----------
# 變數名與 services/api/internal/telemetry/telemetry.go 的 LoadConfig 一致：
# LOKI_ENDPOINT（Phase 01 佔位名，名稱待部署定稿確認）、SENTRY_DSN
#（GlitchTip 的 Sentry 相容 DSN，一律以環境注入）。loki 服務已在
# docker-compose.yml 中定義（內部網路，埠 3100），但 Go 端日誌推送／採集
# 方式待後階段定稿，本變數僅保留位址慣例，不得假裝已接線。
# LOKI_ENDPOINT=http://loki:3100
# SENTRY_DSN=https://example.invalid/0

# ---------- OpenBao 客戶端（停用預設；位址與 Token 見上半部既有註解行） ----------
# OPENBAO_ADDR 與 OPENBAO_TOKEN 已在上半部以註解行保留，不在本段重複定義，
# 以免兩處定義不一致。以下僅新增客戶端慣例變數，全部佔位符：
# OPENBAO_KV_MOUNT=secret
# OPENBAO_AUTH_METHOD=token
# OPENBAO_NAMESPACE=example.invalid
